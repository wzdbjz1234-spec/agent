  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest",
        "description": "创建 Project 的最小请求。"
      },
      "CreateSessionRequest": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          }
        },
        "type": "object",
        "title": "CreateSessionRequest",
        "description": "创建固定属于当前 Project 的连续对话 Session。"
      },
      "CreateTaskRequest": {
        "properties": {
          "project_snapshot_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Project Snapshot Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt"
          }
        },
        "type": "object",
        "required": [
          "project_snapshot_id"
        ],
        "title": "CreateTaskRequest",
        "description": "创建 Task 时固定 Snapshot，并接收用户问题的受控载荷。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RetryTaskRequest": {
        "properties": {
          "project_snapshot_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Snapshot Id"
          }
        },
        "type": "object",
        "title": "RetryTaskRequest",
        "description": "重试仍为显式 Snapshot 选择，防止偷偷切换到项目最新文件。"
      },
      "SendMessageRequest": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 200000,
            "minLength": 1,
            "title": "Content"
          },
          "persist": {
            "type": "boolean",
            "title": "Persist",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "SendMessageRequest",
        "description": "发送一条普通对话消息；它不会隐式创建 Task/Run。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
